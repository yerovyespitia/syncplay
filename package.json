{
  "name": "syncplay",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"bun run --filter @syncplay/server dev\" \"bun run dev:torrent-proxy\" \"bun run --filter @syncplay/desktop dev\"",
    "dev:server": "bun run --filter @syncplay/server dev",
    "dev:torrent-proxy": "node scripts/torrent-proxy.mjs",
    "dev:desktop": "bun run --filter @syncplay/desktop dev",
    "dev:desktop:second": "cd apps/desktop && ELECTRON_RENDERER_URL=http://localhost:5173 bunx electron .",
    "build": "bun run --filter '*' build",
    "dist": "bun run --filter @syncplay/desktop dist",
    "dist:mac": "bun run --filter @syncplay/desktop dist:mac",
    "dist:win": "bun run --filter @syncplay/desktop dist:win",
    "dist:linux": "bun run --filter @syncplay/desktop dist:linux",
    "test": "bun test",
    "check": "bun run --filter '*' check"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "bun-types": "^1.3.11",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}
