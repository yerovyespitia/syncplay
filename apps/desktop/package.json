{
  "name": "@syncplay/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win nsis --x64",
    "dist:linux": "bun run build && electron-builder --linux",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "build": {
    "appId": "com.syncplay.desktop",
    "productName": "SyncPlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "resources/icon.icns"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "@syncplay/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-youtube": "^10.1.0",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/webtorrent": "^0.110.1",
    "@types/youtube": "^0.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "vite": "^6.2.1"
  }
}
